# Copy to .env.local for local development. No real values belong in this file
# or in any committed .env file.

# Where the host (synkro-front) serves the federation entry that exposes
# shell/apiClient and shell/session. Read at build time; the default is the
# host's local dev address.
VITE_SHELL_ENTRY_URL=http://localhost:5173/assets/remoteEntry.js
